{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pskeffington/rusti_rc/blob/main/deployment/release-manifest.schema.json",
  "title": "rusti_rc offline release candidate manifest (schema only; not a verifier)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "release_epoch",
    "security_floor_epoch",
    "source_commit",
    "target_triple",
    "abi_profile",
    "issued_at",
    "expires_at",
    "signer_key_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "release_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "security_floor_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_triple": {
      "type": "string",
      "enum": [
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "arm-unknown-linux-gnueabihf",
        "arm-unknown-linux-musleabihf",
        "armv7-unknown-linux-gnueabihf",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    },
    "abi_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer_key_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,80}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
