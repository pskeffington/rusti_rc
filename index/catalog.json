{
  "schema": 1,
  "project": "rusti_rc",
  "modules": [
    {
      "id": "protocol",
      "prefix": "crates/rusti-proto/",
      "kind": "portable-rust",
      "maturity": "tested-development",
      "summary": "Bounded IRC frames, IRCv3 CAP, tags, registration and SASL state machines; no network I/O.",
      "entrypoints": [
        "crates/rusti-proto/src/lib.rs",
        "crates/rusti-proto/src/registration.rs",
        "crates/rusti-proto/src/sasl.rs"
      ],
      "docs": [
        "docs/security/G1B_PROTOCOL_EVIDENCE.md",
        "docs/architecture/G2B_REGISTRATION_RECOVERY.md"
      ],
      "topics": [
        "irc",
        "frames",
        "tags",
        "cap",
        "sasl",
        "parser"
      ],
      "trust_boundary": "Untrusted IRC text must never authorize Rust Boy actions."
    },
    {
      "id": "client-policy",
      "prefix": "crates/rusti-client/",
      "kind": "portable-rust",
      "maturity": "tested-development",
      "summary": "Disabled connection policy, recovery decisions, and server-bound opaque credential references.",
      "entrypoints": [
        "crates/rusti-client/src/lib.rs",
        "crates/rusti-client/src/recovery.rs",
        "crates/rusti-client/src/credential_ref.rs"
      ],
      "docs": [
        "docs/architecture/G2B_REGISTRATION_RECOVERY.md",
        "docs/architecture/G2D_SASL_NATIVE_CREDENTIALS.md"
      ],
      "topics": [
        "client",
        "recovery",
        "credentials",
        "policy",
        "retry"
      ],
      "trust_boundary": "Credential references are not secrets and recovery proposals do not trigger I/O."
    },
    {
      "id": "server-policy",
      "prefix": "crates/rusti-server/",
      "kind": "portable-rust",
      "maturity": "policy-only-no-listener",
      "summary": "Loopback-only and disabled-by-default local IRC server policy; no implemented listener.",
      "entrypoints": [
        "crates/rusti-server/src/lib.rs"
      ],
      "docs": [
        "docs/architecture/RUST_BOY_INTEGRATION_ROADMAP.md"
      ],
      "topics": [
        "server",
        "listener",
        "loopback",
        "quota"
      ],
      "trust_boundary": "Do not claim a live IRC server or enable public binds."
    },
    {
      "id": "rustboy-adapter",
      "prefix": "crates/rusti-adapter/",
      "kind": "portable-rust",
      "maturity": "read-only-preview",
      "summary": "Untrusted IRC chat inspection and safe text display for possible Rust Boy LINK integration.",
      "entrypoints": [
        "crates/rusti-adapter/src/lib.rs"
      ],
      "docs": [
        "docs/integration/RUST_BOY_ADAPTER_CONTRACT.md"
      ],
      "topics": [
        "rustboy",
        "link",
        "adapter",
        "display",
        "trust"
      ],
      "trust_boundary": "IRC account, nickname and channel never grant Vault, task or organizational authority."
    },
    {
      "id": "testkit",
      "prefix": "crates/rusti-testkit/",
      "kind": "portable-rust",
      "maturity": "synthetic-fixtures",
